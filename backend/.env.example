# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env de verdade (já está no .gitignore).

# Chave da API do Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Senha longa e exclusiva para abrir e confirmar alterações em Configurações.
# As configurações são desativadas se esta senha não estiver definida.
MARIA_SETTINGS_PASSWORD=Senh@Forte_2026

# Modelo de linguagem (mesmo do notebook)
MODELO_LLM=gemini-3.6-flash

# Modelo de embeddings locais (mesmo do notebook)
MODELO_EMB=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Caminho pro arquivo .md da base de conhecimento
# (o mesmo que estava em /content/drive/MyDrive/MARIA/conhecimento/... no Colab)
KB_PATH=./data/knowledge_base.md

# Pasta com os CSVs do pipeline (features_vitima.csv, features_agressor.csv,
# features_historico.csv, features_territorial.csv, MARIA_chaves.csv)
# usados só pelo endpoint /api/stats, opcional
DADOS_BI_PATH=./data/dados_bi

# Onde persistir o índice vetorial local (cache de embeddings) — só usado
# se DATABASE_URL abaixo estiver vazia.
INDEX_DIR=./data/indice

# String de conexão do Postgres com a extensão pgvector habilitada.
# Se preenchida, o retrieval roda 100% no banco (maria_chunks/maria_kb_meta
# — ver sql/schema_pgvector.sql) em vez do índice local em arquivo.
# Rode `psql "$DATABASE_URL" -f sql/schema_pgvector.sql` uma vez, depois
# `python scripts/indexador.py` pra popular/atualizar o índice.
# Deixe vazia pra rodar em modo local (sem precisar de banco).
# Supabase: substitua SUA_SENHA pelo Database Password do projeto.
# Codifique caracteres especiais da senha como URL-encoding (ex.: @ = %40).
# A conexão exige SSL. Não use a chave publishable do Supabase aqui.
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.xboauvlojlhpaagsnakm.supabase.co:5432/postgres?sslmode=require

# Comportamento do chat
MAX_TURNOS_HISTORICO=6
TIMEOUT_REQUEST_S=45
# Score mínimo da base de conhecimento; 0.0 desativa a abstenção.
LIMIAR_SIMILARIDADE=0.30

# Origens permitidas pro CORS (separadas por vírgula)
# Em dev, a porta padrão do Vite é 5173
FRONTEND_ORIGINS=http://localhost:5173
